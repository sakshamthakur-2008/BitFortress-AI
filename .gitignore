# ============================================================
# BitFortress AI — .gitignore
# ============================================================

# ── Environment / Secrets ───────────────────────────────────
.env
.env.*
!.env.example
*.env
env/
.env/
venv/
.venv/

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
*.egg
dist/
build/
*.so
.Python

# ── Node / React ────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/build/
frontend/.env
frontend/.env.*
!frontend/.env.example

# ── Backups & temp ──────────────────────────────────────────
frontend_backup/

# ── Build outputs ───────────────────────────────────────────
dist/
build/
*.min.js.map

# ── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── OS files ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── IDE ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Coverage / Test ─────────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.coverage

# ── Local Workspace & Legacy Prototypes ─────────────────────
boss.py
worker.py
run_all.py
start_bitfortress.bat
index.html
metadata.json
storage_node*/
inde.html/
vault/
prog*
import pandas as pd.py

